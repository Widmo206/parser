var y = -5;
# postfix notation is not a feature; it's lack of expression validation
const x: float = 1.0e-6 * 5e7 + 1.1 / (y 3 %);
{ # this shouldn't affect the original x
    var x: int = 42;
    y = true;
    print(x);
}
